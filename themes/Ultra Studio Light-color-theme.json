{
	"name": "Ultra Studio Light",
	"colors": {
		"editor.background": "#FFFFFF",
		"editor.foreground": "#333333",
		"editorLineNumber.foreground": "#888888",
		"editorLineNumber.activeForeground": "#333333",
		"editor.selectionBackground": "#ADD6FF",
		"editor.inactiveSelectionBackground": "#b0d1ff",
		"editorCursor.foreground": "#89DDFF",
		"editorIndentGuide.background1": "#303640",
		"editorIndentGuide.activeBackground1": "#4A5564",
		"editorWhitespace.foreground": "#424B58",
		"editor.findMatchBackground": "#665C2B",
		"editor.findMatchHighlightBackground": "#3E4028",
		"editorBracketMatch.background": "#394352",
		"editorBracketMatch.border": "#82AAFF",
		"editorGutter.background": "#252A33",
		"editorWidget.background": "#20252D",
		"editorWidget.border": "#3A424E",
		"editorHoverWidget.background": "#20252D",
		"editorHoverWidget.border": "#3A424E",
		"editorSuggestWidget.background": "#20252D",
		"editorSuggestWidget.border": "#3A424E",
		"editorSuggestWidget.selectedBackground": "#303945",

		"activityBar.background": "#1F242C",
		"activityBar.foreground": "#E6EDF3",
		"activityBar.inactiveForeground": "#788493",
		"activityBarBadge.background": "#007ACC",
		"activityBarBadge.foreground": "#FFFFFF",

		"sideBar.background": "#20252D",
		"sideBar.foreground": "#C8D0D9",
		"sideBarTitle.foreground": "#AEB7C2",
		"sideBarSectionHeader.background": "#252A33",
		"sideBarSectionHeader.foreground": "#D5DCE5",

		"statusBar.background": "#1B2027",
		"statusBar.foreground": "#C8D0D9",
		"statusBarItem.hoverBackground": "#303742",

		"titleBar.activeBackground": "#1F242C",
		"titleBar.activeForeground": "#E6EDF3",
		"titleBar.inactiveBackground": "#1B2027",
		"titleBar.inactiveForeground": "#788493",

		"tab.activeBackground": "#252A33",
		"tab.activeForeground": "#E6EDF3",
		"tab.inactiveBackground": "#20252D",
		"tab.inactiveForeground": "#788493",
		"tab.activeBorderTop": "#82AAFF",

		"panel.background": "#1D2229",
		"panel.border": "#303640",
		"panelTitle.activeForeground": "#E6EDF3",
		"panelTitle.inactiveForeground": "#788493",

		"terminal.background": "#1D2229",
		"terminal.foreground": "#E6EDF3",
		"terminalCursor.foreground": "#89DDFF",

		"input.background": "#1D2229",
		"input.foreground": "#E6EDF3",
		"input.border": "#3A424E",
		"inputOption.activeBackground": "#303945",
		"inputOption.activeBorder": "#82AAFF",

		"focusBorder": "#82AAFF",
		"list.activeSelectionBackground": "#303945",
		"list.activeSelectionForeground": "#FFFFFF",
		"list.hoverBackground": "#292F38",
		"list.focusBackground": "#303945",

		"button.background": "#007ACC",
		"button.foreground": "#FFFFFF",
		"button.hoverBackground": "#168AD0"
	},
	"tokenColors": [
		{
			"name": "Comment",
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#788493"
			}
		},
		{
			"name": "Variables",
			"scope": [
				"variable",
				"string constant.other.placeholder"
			],
			"settings": {
				"foreground": "#5FD18A"
			}
		},
		{
			"name": "Colors",
			"scope": [
				"constant.other.color"
			],
			"settings": {
				"foreground": "#5FD18A"
			}
		},
		{
			"name": "Invalid",
			"scope": [
				"invalid",
				"invalid.illegal"
			],
			"settings": {
				"foreground": "#FF5370"
			}
		},
		{
			"name": "Keyword, Storage",
			"scope": [
				"keyword",
				"storage.type",
				"storage.modifier"
			],
			"settings": {
				"foreground": "#FF007D",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Operator, Misc",
			"scope": [
				"keyword.control",
				"punctuation",
				"meta.tag",
				"punctuation.definition.tag",
				"punctuation.separator.inheritance.php",
				"punctuation.definition.tag.html",
				"punctuation.definition.tag.begin.html",
				"punctuation.definition.tag.end.html",
				"punctuation.section.embedded",
				"keyword.other.template",
				"keyword.other.substitution"
			],
			"settings": {
				"foreground": "#C792EA",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Tag",
			"scope": [
				"entity.name.tag",
				"meta.tag.sgml",
				"markup.deleted.git_gutter"
			],
			"settings": {
				"foreground": "#F07178",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Function, Special Method",
			"scope": [
				"entity.name.function",
				"meta.function-call",
				"variable.function",
				"support.function",
				"keyword.other.special-method"
			],
			"settings": {
				"foreground": "#FFD866",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Block Level Variables",
			"scope": [
				"meta.block variable.other"
			],
			"settings": {
				"foreground": "#F07178"
			}
		},
		{
			"name": "Other Variable, String Link",
			"scope": [
				"support.other.variable",
				"string.other.link"
			],
			"settings": {
				"foreground": "#5FD18A"
			}
		},
		{
			"name": "Number, Constant, Function Argument, Tag Attribute, Embedded",
			"scope": [
				"constant.numeric",
				"constant.language",
				"support.constant",
				"constant.character",
				"constant.escape",
				"variable.parameter",
				"keyword.other.unit",
				"keyword.other"
			],
			"settings": {
				"foreground": "#FFB454"
			}
		},
		{
			"name": "String, Symbols, Inherited Class, Markup Heading",
			"scope": [
				"string",
				"string.quoted",
				"string.unquoted",
				"punctuation.definition.string",
				"punctuation.definition.string.begin",
				"punctuation.definition.string.end",
				"constant.other.symbol",
				"constant.other.key",
				"entity.other.inherited-class",
				"markup.heading",
				"markup.heading entity.name",
				"markup.inserted.git_gutter",
				"meta.group.braces.curly constant.other.object.key.js string.unquoted.label.js"
			],
			"settings": {
				"foreground": "#A8E063"
			}
		},
		{
			"name": "Class, Support",
			"scope": [
				"entity.name",
				"support.type",
				"support.class",
				"support.other.namespace.use.php",
				"meta.use.php",
				"support.other.namespace.php",
				"markup.changed.git_gutter",
				"support.type.sys-types"
			],
			"settings": {
				"foreground": "#FFCB6B"
			}
		},
		{
			"name": "Entity Types",
			"scope": [
				"support.type"
			],
			"settings": {
				"foreground": "#F78CFF",
				"fontStyle": "bold"
			}
		},
		{
			"name": "CSS Class and Support",
			"scope": [
				"source.css support.type.property-name",
				"source.sass support.type.property-name",
				"source.scss support.type.property-name",
				"source.less support.type.property-name",
				"source.stylus support.type.property-name",
				"source.postcss support.type.property-name"
			],
			"settings": {
				"foreground": "#00B7FF",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Sub-methods",
			"scope": [
				"entity.name.module.js",
				"variable.import.parameter.js",
				"variable.other.class.js"
			],
			"settings": {
				"foreground": "#FF5370"
			}
		},
		{
			"name": "Language methods",
			"scope": [
				"variable.language"
			],
			"settings": {
				"fontStyle": "italic bold",
				"foreground": "#FF5370"
			}
		},
		{
			"name": "entity.name.method.js",
			"scope": [
				"entity.name.method.js"
			],
			"settings": {
				"fontStyle": "italic bold",
				"foreground": "#82AAFF"
			}
		},
		{
			"name": "meta.method.js",
			"scope": [
				"meta.class-method.js entity.name.function.js",
				"variable.function.constructor"
			],
			"settings": {
				"foreground": "#82AAFF"
			}
		},
		{
			"name": "Attributes",
			"scope": [
				"entity.other.attribute-name"
			],
			"settings": {
				"foreground": "#A43D49"
			}
		},
		{
			"name": "HTML Attributes",
			"scope": [
				"text.html.basic entity.other.attribute-name.html",
				"text.html.basic entity.other.attribute-name"
			],
			"settings": {
				"fontStyle": "italic bold",
				"foreground": "#FFCB6B"
			}
		},
		{
			"name": "CSS Classes",
			"scope": [
				"entity.other.attribute-name.class"
			],
			"settings": {
				"foreground": "#FFCB6B"
			}
		},
		{
			"name": "CSS ID's",
			"scope": [
				"source.sass keyword.control"
			],
			"settings": {
				"foreground": "#82AAFF"
			}
		},
		{
			"name": "Inserted",
			"scope": [
				"markup.inserted"
			],
			"settings": {
				"foreground": "#C3E88D"
			}
		},
		{
			"name": "Deleted",
			"scope": [
				"markup.deleted"
			],
			"settings": {
				"foreground": "#FF5370"
			}
		},
		{
			"name": "Changed",
			"scope": [
				"markup.changed"
			],
			"settings": {
				"foreground": "#C792EA"
			}
		},
		{
			"name": "Regular Expressions",
			"scope": [
				"string.regexp"
			],
			"settings": {
				"foreground": "#A8E063"
			}
		},
		{
			"name": "Escape Characters",
			"scope": [
				"constant.character.escape"
			],
			"settings": {
				"foreground": "#89DDFF"
			}
		},
		{
			"name": "URL",
			"scope": [
				"*url*",
				"*link*",
				"*uri*"
			],
			"settings": {
				"fontStyle": "bold underline",
				"foreground": "#4DA6FF"
			}
		},
		{
			"name": "Decorators",
			"scope": [
				"tag.decorator.js entity.name.tag.js",
				"tag.decorator.js punctuation.definition.tag.js"
			],
			"settings": {
				"fontStyle": "italic bold",
				"foreground": "#82AAFF"
			}
		},
		{
			"name": "ES7 Bind Operator",
			"scope": [
				"source.js constant.other.object.key.js string.unquoted.label.js"
			],
			"settings": {
				"fontStyle": "italic bold",
				"foreground": "#5FD18A"
			}
		},
		{
			"name": "JSON Key - Level 0",
			"scope": [
				"source.json meta.structure.dictionary.json support.type.property-name.json"
			],
			"settings": {
